[TEMPLATE]
# AI-Powered Visual Attendance System — environment template
#
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
#
# `.env` is git-ignored; never commit real secrets.
#
# IMPORTANT — what belongs here vs. in src/config.py (see ARCHITECTURE.md D5):
#   * Environment-specific values go here (this file).
#   * Application constants (camera index/frame size, face-processing
#     thresholds, enrollment sample counts) do NOT go here — they are
#     frozen constants in src/config.py and are tuned in that one place.
# Only keys actually consumed by the implemented code are listed.

# --- Application (consumed by src/config.py, Step 02) ---
# One of: development | testing | staging | production
APP_ENV=development
# Strict boolean: 1/true/yes/on or 0/false/no/off
DEBUG=false

# --- Paths (consumed by src/config.py, Step 02) ---
# Relative values are anchored to the project root; absolute paths allowed.
DATA_DIR=data
LOG_DIR=data/logs

# --- Logging level (consumed by src/logging_setup.py, Step 01) ---
LOG_LEVEL=INFO

# --- Phase 3: PostgreSQL employee metadata (consumed by src/config.py
#     and src/db.py) ---
#
# ATTENDANCE_DATABASE_URL — DSN for the application's employee-metadata
# database. Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# (psycopg 3 keyword-value style, e.g.
#   ATTENDANCE_DATABASE_URL=host=127.0.0.1 port=5432 dbname=attendance
# is accepted identically).
#
# SECURITY: real credentials must never be committed. The value below is
# a placeholder, not a real password.
#
# Example placeholder (loopback-only local development):
# ATTENDANCE_DATABASE_URL=postgresql://attendance_app:CHANGE_ME@127.0.0.1:5432/attendance

# --- Phase 3: dedicated PostgreSQL test database (integration tests
#     only; consumed by src/config.py) ---
#
# ATTENDANCE_TEST_DATABASE_URL — DSN for a dedicated, disposable local
# test database. Phase 3 integration tests positively verify this DSN and
# refuse to touch any other target before performing destructive setup.
# Never point it at a shared or production database.
#
# Example placeholder (loopback-only, isolated test database):
# ATTENDANCE_TEST_DATABASE_URL=postgresql://attendance_test:CHANGE_ME@127.0.0.1:5432/attendance_test

# --- Phase 3: development API binding (consumed by src/config.py) ---
#
# API_HOST — loopback-only. Accepted values: localhost, any 127.0.0.0/8
# address, or ::1. Non-loopback binding is rejected (Phase 3's API must
# never accidentally bind outward).
API_HOST=127.0.0.1
# API_PORT — TCP port in [1, 65535]. Non-integer or out-of-range values
# reject at load time.
API_PORT=8000
