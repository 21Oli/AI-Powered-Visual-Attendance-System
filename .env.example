# AI-Powered Visual Attendance System — environment template
#
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
#
# `.env` is git-ignored; never commit real secrets.
#
# IMPORTANT — what belongs here vs. in src/config.py (see ARCHITECTURE.md D5):
#   * Environment-specific values go here (this file).
#   * Application constants (camera index/frame size, face-processing
#     thresholds, enrollment sample counts) do NOT go here — they are
#     frozen constants in src/config.py and are tuned in that one place.
# Only keys actually consumed by the implemented code are listed.

# --- Application (consumed by src/config.py, Step 02) ---
# One of: development | testing | staging | production
APP_ENV=development
# Strict boolean: 1/true/yes/on or 0/false/no/off
DEBUG=false

# --- Paths (consumed by src/config.py, Step 02) ---
# Relative values are anchored to the project root; absolute paths allowed.
DATA_DIR=data
LOG_DIR=data/logs

# --- Logging level (consumed by src/logging_setup.py, Step 01) ---
LOG_LEVEL=INFO
