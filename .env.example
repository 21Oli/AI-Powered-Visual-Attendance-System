# AI-Powered Visual Attendance System — environment template
#
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
#
# `.env` is git-ignored; never commit real secrets. Only keys that are
# actually consumed by the implemented code are listed here.

# --- Logging (consumed by src/logging_setup.py, Step 01) ---
LOG_LEVEL=INFO
LOG_DIR=data/logs

# --- Data locations (documented for upcoming steps) ---
DATA_DIR=data
